<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseAppHost>true</UseAppHost>
    <AssemblyName Condition="'$(AssemblyName)' == ''">CodeVein2RandomizerLauncher</AssemblyName>
    <AssemblyTitle>Code Vein 2 Randomizer</AssemblyTitle>
    <Product>Code Vein 2 Randomizer</Product>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">$(Version).0</AssemblyVersion>
    <FileVersion Condition="'$(FileVersion)' == ''">$(Version).0</FileVersion>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Optimize>true</Optimize>
    <ApplicationIcon>..\..\ico\icon.ico</ApplicationIcon>
    <PayloadArchive Condition="'$(PayloadArchive)' == ''">$(MSBuildProjectDirectory)\Payload.zip</PayloadArchive>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(PayloadArchive)" LogicalName="CV2Launcher.Payload.zip" />
  </ItemGroup>
  <Target Name="RequireEmbeddedPayload" BeforeTargets="PrepareResourceNames">
    <Error Condition="!Exists('$(PayloadArchive)')"
           Text="Missing the onedir app payload. Pass -p:PayloadArchive=&lt;payload.zip&gt;." />
  </Target>
</Project>
